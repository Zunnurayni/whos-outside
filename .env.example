# ─────────────────────────────────────────────────────────────
# Who's Outside? — environment variables
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local. Only NEXT_PUBLIC_* vars reach the browser.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Bypasses RLS — used only in trusted server code, never shipped to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# App URL (used for Snapchat share deep-links and OAuth callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Deferred to later phases (leave blank for now) ──

# Mapping provider — pick one when you reach Phase 3
NEXT_PUBLIC_MAPBOX_TOKEN=
# or
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Snapchat Snap Kit — Phase 5 (register at https://devportal.snap.com)
NEXT_PUBLIC_SNAPCHAT_CLIENT_ID=
SNAPCHAT_CLIENT_SECRET=

# Gemini API — optional, Phase 4+
GEMINI_API_KEY=
